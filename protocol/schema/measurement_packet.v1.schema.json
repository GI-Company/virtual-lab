{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeasurementPacket",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "message_type": {
      "type": "string",
      "const": "MEASUREMENT_PACKET"
    },
    "stream_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_timebase": {
      "type": "string",
      "const": "MONOTONIC"
    },
    "device_timestamp_ns": {
      "type": "integer"
    },
    "device_utc_ns": {
      "type": ["integer", "null"]
    },
    "sequence": {
      "type": "integer"
    },
    "sensor_id": {
      "type": "string"
    },
    "measurement_type": {
      "type": "string"
    },
    "source_session_id": {
      "type": ["string", "null"]
    },
    "values": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "units": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "accuracy": {
      "type": ["integer", "string", "null"]
    }
  },
  "required": [
    "schema_version", 
    "message_type", 
    "stream_id",
    "device_id",
    "device_timebase", 
    "device_timestamp_ns",
    "sequence",
    "sensor_id", 
    "measurement_type",
    "values",
    "units"
  ]
}
